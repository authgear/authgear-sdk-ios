default_platform(:ios)

platform :ios do
  lane :sdk_xcframework do
    # It turns out SKIP_INSTALL=NO and BUILD_LIBRARY_FOR_DISTRIBUTION=YES are essential
    # so that the archive contains a .framework output.

    # .framework for the device
    xcarchive(
      destination: "generic/platform=iOS",
      workspace: "./Authgear.xcworkspace",
      scheme: "Authgear-iOS",
      configuration: "Release",
      xcargs: "SKIP_INSTALL=NO BUILD_LIBRARY_FOR_DISTRIBUTION=YES",
      archive_path: "./build/Release/iOS/Authgear.xcarchive"
    )
    # .framework for the simulator
    xcarchive(
      destination: "generic/platform=iOS Simulator",
      workspace: "./Authgear.xcworkspace",
      scheme: "Authgear-iOS",
      configuration: "Release",
      xcargs: "SKIP_INSTALL=NO BUILD_LIBRARY_FOR_DISTRIBUTION=YES",
      archive_path: "./build/Release/iOS_Simulator/Authgear.xcarchive"
    )
    # .xcframework
    create_xcframework(
      frameworks: [
        "./build/Release/iOS/Authgear.xcarchive/Products/Library/Frameworks/Authgear.framework",
        "./build/Release/iOS_Simulator/Authgear.xcarchive/Products/Library/Frameworks/Authgear.framework"
      ],
      output: "./build/Release/Authgear.xcframework"
    )
  end

  lane :sdk_test do
    # Use scan to run tests.
    # It knows how to run available simulators and use the first of them.
    # See https://docs.fastlane.tools/actions/scan/
    scan(
      workspace: "./Authgear.xcworkspace",
      scheme: "Authgear-iOS"
    )
  end

  lane :example_build_app do |options|
    build_app(
      destination: "generic/platform=iOS",
      workspace: "./example/ios_example.xcworkspace",
      scheme: "iOS-Example",
      configuration: "Release",
      export_options: "./example/ExportOptions.plist",
      clean: true,
      output_directory: "./build/Release/iOS/ios_example",
      output_name: "ios_example.ipa",
      xcargs: "CURRENT_PROJECT_VERSION=#{options[:CURRENT_PROJECT_VERSION]}",
    )
  end

  lane :example_upload_app do
    # Pin the target app explicitly. com.authgear.sdk.exampleapp.ios is a string
    # prefix of com.authgear.sdk.exampleapp.ios.app2, and the App Store Connect
    # API's filter[bundleId] is a partial match, so letting the app be inferred
    # from the ipa is ambiguous. apple_id skips app resolution entirely.
    upload_to_testflight(
      app_identifier: "com.authgear.sdk.exampleapp.ios",
      apple_id: "6444355849",
      skip_waiting_for_build_processing: true,
      api_key_path: "./build/fastlane-api-key.json",
      ipa: "./build/Release/iOS/ios_example/ios_example.ipa"
    )
  end

  lane :example_build_app2 do |options|
    build_app(
      destination: "generic/platform=iOS",
      workspace: "./example/ios_example.xcworkspace",
      scheme: "iOS-Example-App2",
      configuration: "Release-App2",
      export_options: "./example/ExportOptions-App2.plist",
      clean: true,
      output_directory: "./build/Release/iOS/ios_example_app2",
      output_name: "ios_example_app2.ipa",
      xcargs: "CURRENT_PROJECT_VERSION=#{options[:CURRENT_PROJECT_VERSION]}",
    )
  end

  lane :example_upload_app2 do
    # Pinned for the same reason as example_upload_app, so a future third
    # variant cannot reintroduce the ambiguity.
    upload_to_testflight(
      app_identifier: "com.authgear.sdk.exampleapp.ios.app2",
      apple_id: "6807455024",
      skip_waiting_for_build_processing: true,
      api_key_path: "./build/fastlane-api-key.json",
      ipa: "./build/Release/iOS/ios_example_app2/ios_example_app2.ipa"
    )
  end
end
